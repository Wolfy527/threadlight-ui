.threadlight-description,
.threadlight-mirroring-card-description {
    font-size: 12px;
    white-space: normal;
}

/* Shared roots and surfaces */
.threadlight-inspector-root {
    position: relative;
    overflow: hidden;
    padding: 6px;
}
.threadlight-aurora-atmosphere {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}
.threadlight-bordered-surface {
    border-width: 1px;
}
.threadlight-banner {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px 10px 10px;
    border-width: 1px;
    border-radius: 7px;
}
.threadlight-level--page {
    margin-bottom: 2px;
}
.threadlight-level--feature {
    border-width: 1px;
}
.threadlight-level--section {
    border-width: 1px;
}
.threadlight-level--detail {
    letter-spacing: 0.2px;
}
.threadlight-banner-logo {
    width: 42px;
    height: 42px;
    min-width: 42px;
    margin-right: 10px;
}
.threadlight-banner-copy,
.threadlight-footer-copy {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.threadlight-banner-title {
    font-size: 15px;
    -unity-font-style: bold;
    white-space: normal;
}
.threadlight-banner-description {
    margin-top: 2px;
}
.threadlight-message {
    margin-top: 2px;
    margin-bottom: 2px;
    padding: 8px 9px;
    border-width: 1px;
    border-radius: 6px;
}
.threadlight-message-title {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}
.threadlight-message-body {
    margin-top: 3px;
}
.threadlight-page-section {
    margin-top: 10px;
    padding: 9px 10px 10px 10px;
}
.threadlight-page-section-title {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}
.threadlight-page-section-body {
    margin-top: 3px;
}
.threadlight-page-section-content {
    margin-top: 7px;
    min-width: 0;
}
.threadlight-read-only-row {
    min-height: 27px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    margin: 1px 0;
    border-radius: 4px;
}
.threadlight-read-only-name {
    width: 40%;
    min-width: 96px;
    max-width: 180px;
    flex-shrink: 1;
    white-space: normal;
}
.threadlight-read-only-value {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    -unity-text-align: middle-right;
    white-space: normal;
}
.threadlight-read-only-row--stacked {
    min-height: 42px;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    padding-top: 4px;
    padding-bottom: 4px;
}
.threadlight-read-only-row--stacked > .threadlight-read-only-name {
    width: auto;
    min-width: 0;
    max-width: none;
}
.threadlight-read-only-row--stacked > .threadlight-read-only-value {
    -unity-text-align: middle-left;
}

.threadlight-action-strip {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 5px;
}
.threadlight-action-strip > .threadlight-compact-button,
.threadlight-action-strip > .threadlight-primary-button {
    margin-top: 0;
    margin-right: 5px;
    margin-bottom: 3px;
}
.threadlight-action-strip--stacked {
    flex-direction: column;
}
.threadlight-action-strip--stacked > .threadlight-compact-button,
.threadlight-action-strip--stacked > .threadlight-primary-button {
    width: auto;
    min-width: 0;
    margin-right: 0;
}
.threadlight-field-action-row {
    margin-top: 2px;
    margin-bottom: 2px;
    flex-direction: row;
    align-items: center;
}
.threadlight-field-action-control {
    min-width: 0;
    flex-grow: 1;
}
.threadlight-field-action-button {
    flex-shrink: 0;
}
.threadlight-field-action-row--stacked {
    flex-direction: column;
    align-items: stretch;
}
.threadlight-field-action-row--stacked > .threadlight-field,
.threadlight-field-action-row--stacked > .threadlight-field-action-control {
    width: auto;
}
.threadlight-field-action-row--stacked > .threadlight-compact-button,
.threadlight-field-action-row--stacked > .threadlight-field-action-button {
    width: auto;
    min-width: 0;
    margin-top: 4px;
    margin-left: 0;
}

/* Shared buttons and footer */
.threadlight-primary-button,
.threadlight-compact-button {
    -unity-font-style: bold;
    border-width: 1px;
}
.threadlight-primary-button {
    height: 30px;
    margin-top: 8px;
    border-radius: 6px;
}
.threadlight-compact-button {
    height: 26px;
    border-radius: 5px;
}
.threadlight-icon-button {
    border-width: 1px;
    border-radius: 4px;
}
.threadlight-interactive-button:active {
    opacity: 0.84;
}
.threadlight-footer-dock {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: auto;
    flex-direction: row;
    align-items: center;
    margin: 2px 4px;
    padding: 5px 10px;
    border-width: 1px;
    border-radius: 8px;
}
.threadlight-footer-copy {
    justify-content: center;
    overflow: hidden;
}
.threadlight-footer-title {
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}
.threadlight-card {
    padding: 8px 9px;
}
.threadlight-card-title {
    -unity-font-style: bold;
}
.threadlight-card-body {
    margin-top: 2px;
}
.threadlight-overlay-viewport {
    margin-right: 0;
    flex-grow: 1;
}
.threadlight-overlay-content {
    padding-right: 8px;
}
.threadlight-overlay-scroller {
    position: absolute;
    right: 1px;
    top: 1px;
    bottom: 1px;
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    margin-left: 0;
    margin-right: 0;
}
.threadlight-overlay-scroller-button {
    display: none;
}
.threadlight-overlay-slider {
    width: 6px;
    min-width: 6px;
    max-width: 6px;
    margin-left: 0;
    margin-right: 0;
}
.threadlight-overlay-dragger {
    width: 4px;
    min-width: 4px;
    border-radius: 2px;
}

/* Serialized controls */
.threadlight-field {
    min-height: 32px;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 2px;
    flex-shrink: 0;
    min-width: 0;
}
.threadlight-field > .unity-base-field__label {
    min-width: 112px;
    width: 36%;
    max-width: 260px;
    min-height: 28px;
    height: auto;
    padding-right: 10px;
    -unity-text-align: middle-left;
    white-space: normal;
    overflow: hidden;
    text-overflow: clip;
}
.threadlight-field--stacked {
    min-height: 54px;
    flex-direction: column;
    align-items: stretch;
}
.threadlight-field--stacked > .unity-base-field__label {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    min-height: 22px;
    height: auto;
    margin-bottom: 4px;
    padding-right: 0;
}
.threadlight-field--stacked > .unity-base-field__input {
    width: 100%;
    min-width: 0;
    min-height: 28px;
    height: 28px;
    flex-grow: 0;
    flex-shrink: 0;
}
.threadlight-field-input {
    min-height: 28px;
    height: 28px;
    min-width: 0;
    max-width: 100%;
    align-items: center;
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    border-width: 1px;
}
.threadlight-field-input-standard {
    border-radius: 5px;
}
.threadlight-field-input-axis {
    border-radius: 4px;
}
.threadlight-field.threadlight-field--numeric > .unity-base-field__input {
    width: 96px;
    max-width: 100%;
    flex-basis: auto;
    flex-grow: 0;
    flex-shrink: 1;
    align-self: flex-start;
}
.threadlight-field.threadlight-field--wide-number > .unity-base-field__input {
    width: 144px;
}
.threadlight-vector-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.threadlight-subcategory-label {
    align-self: flex-start;
    height: 28px;
    max-width: 100%;
    margin-top: 10px;
    margin-bottom: 7px;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 8px;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.threadlight-status-badge {
    border-width: 1px;
}
.threadlight-field .unity-text-input,
.threadlight-field .unity-base-popup-field__text,
.threadlight-field .unity-object-field-display,
.threadlight-field .unity-object-field-display__label,
.threadlight-composite-axis .unity-text-input {
    min-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-left;
    align-items: center;
}
.threadlight-field .unity-object-field__selector {
    position: relative;
    border-width: 1px;
    border-radius: 5px;
    width: 22px;
    min-width: 22px;
    max-width: 22px;
    height: 22px;
    min-height: 22px;
    max-height: 22px;
    flex-grow: 0;
    flex-shrink: 0;
    padding: 0;
    margin: 0 2px 0 1px;
    background-image: none;
}
.threadlight-object-picker-icon {
    position: absolute;
    left: 0;
    top: 0;
    flex-grow: 0;
    flex-shrink: 0;
}
.threadlight-field .unity-base-popup-field__arrow {
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    flex-shrink: 0;
}
.threadlight-field .unity-object-field-display,
.threadlight-field .unity-base-popup-field__text {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}
.threadlight-field .unity-composite-field__field {
    align-items: center;
}
.threadlight-slider,
.threadlight-slider .unity-base-slider__input,
.threadlight-slider .unity-base-slider__drag-container {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}
.threadlight-slider .unity-base-slider__text-field {
    width: 54px;
    min-width: 46px;
    max-width: 64px;
    flex-grow: 0;
    flex-shrink: 0;
}
.threadlight-field Label,
.threadlight-composite-axis Label {
    -unity-text-align: middle-left;
    align-self: center;
}
.threadlight-toggle-row {
    min-height: 32px;
    margin-top: 2px;
    margin-bottom: 2px;
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    flex-shrink: 1;
    min-width: 0;
    max-width: 100%;
    margin-left: 3px;
    margin-right: 3px;
    padding-left: 9px;
    padding-right: 5px;
}
.threadlight-toggle-row-title {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 28px;
    padding-right: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.threadlight-toggle-row--wrapped {
    min-height: 40px;
}
.threadlight-toggle-row--wrapped > .threadlight-toggle-row-title {
    height: auto;
    min-height: 28px;
    white-space: normal;
    text-overflow: clip;
}
.threadlight-toggle-control {
    width: 42px;
    min-width: 42px;
    max-width: 42px;
    height: 20px;
    flex-shrink: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 0 4px 1px 4px;
    border-radius: 10px;
}

/* Expandable module and Live Mirroring cards */
.threadlight-module-group {
    min-width: 0;
    margin-bottom: 20px;
    padding: 5px 6px;
    border-width: 1px;
    border-radius: 11px;
}
.threadlight-module-header {
    min-width: 0;
    height: 32px;
    margin: 0 4px 5px 4px;
    padding: 0 4px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    transition-property: margin-bottom, border-bottom-width, border-bottom-color;
    transition-duration: 0.18s;
    transition-timing-function: ease-in-out;
}
.threadlight-module-indicator {
    width: 18px;
    min-width: 18px;
    margin-right: 3px;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.threadlight-module-title {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.threadlight-module-kind {
    height: 18px;
    flex-shrink: 0;
    margin-left: 8px;
    padding: 0 7px;
    font-size: 8px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-radius: 9px;
}
.threadlight-module-accessories {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.threadlight-expandable-body {
    overflow: hidden;
    transition-property: max-height, opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-in-out;
}
.threadlight-module-body {
    min-width: 0;
    padding: 8px;
}

.threadlight-reduced-motion * {
    transition-duration: 0s;
}

.threadlight-reduced-motion #wolfy-pointer-light {
    display: none;
}
.threadlight-mirroring-card {
    margin-top: 0;
}
.threadlight-mirroring-target-card {
    margin-top: 0;
    margin-bottom: 16px;
}
.threadlight-mirroring-card-description {
    margin: 4px 2px 12px 2px;
}
.threadlight-mirroring-validation-badge {
    display: none;
    height: 18px;
    padding-left: 7px;
    padding-right: 7px;
    border-radius: 9px;
    font-size: 8px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.threadlight-mirroring-target-validation-badge {
    flex-shrink: 0;
    margin-left: 5px;
    margin-right: 5px;
    padding-left: 6px;
    padding-right: 6px;
}
.threadlight-mirroring-remove-target {
    width: 72px;
    height: 22px;
    flex-shrink: 0;
    margin: 0;
}
.threadlight-mirroring-validation-summary {
    min-height: 20px;
    margin-top: 3px;
    padding-left: 7px;
    padding-right: 7px;
    justify-content: center;
    border-width: 1px;
    border-radius: 4px;
}
.threadlight-mirroring-validation-summary-label {
    font-size: 9px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Live Mirroring window composition */
.threadlight-mirroring-window-root {
    flex-grow: 1;
    flex-direction: column;
    position: relative;
    overflow: hidden;
}
.threadlight-mirroring-window-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 10px;
}
.threadlight-mirroring-footer-row {
    position: absolute;
    left: 8px;
    right: 8px;
    bottom: 8px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: stretch;
    margin: 0;
}
.threadlight-mirroring-page-content {
    flex-direction: column;
    flex-grow: 1;
    position: relative;
    overflow: hidden;
}
.threadlight-mirroring-footer-actions {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}
.threadlight-mirroring-footer-actions > .threadlight-mirroring-action-button {
    min-width: 132px;
    height: 30px;
    margin-top: 0;
    margin-bottom: 0;
    align-self: center;
}
.threadlight-studio-footer.threadlight-footer--stacked {
    flex-direction: column;
    align-items: stretch;
}
.threadlight-footer--stacked .threadlight-footer-copy {
    width: 100%;
    min-height: 32px;
}
.threadlight-footer--stacked .threadlight-footer-actions {
    width: 100%;
    min-width: 0;
    flex-shrink: 1;
    flex-wrap: wrap;
    justify-content: flex-end;
    margin-top: 6px;
}
.threadlight-studio-footer .threadlight-footer-button {
    width: 150px;
    max-width: 100%;
    min-width: 0;
    height: 30px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
}
.threadlight-footer--stacked .threadlight-footer-button {
    align-self: flex-end;
    margin-left: 0;
    margin-top: 6px;
}
.threadlight-footer--stacked .threadlight-footer-actions > .threadlight-footer-button {
    margin-left: 6px;
}
.threadlight-mirroring-footer-button {
    width: 150px;
    height: 30px;
    flex-shrink: 0;
    margin-left: 0;
    border-width: 1px;
    border-radius: 5px;
    -unity-font-style: bold;
}
.threadlight-mirroring-scale-handle-row {
    min-width: 0;
}
.threadlight-mirroring-scale-handle-remove {
    width: 66px;
    min-width: 66px;
    flex-shrink: 0;
    margin-right: 0;
    padding-left: 5px;
    padding-right: 5px;
}
.threadlight-mirroring-action-row {
    min-width: 0;
}
.threadlight-mirroring-action-button {
    min-width: 0;
}
.threadlight-mirroring-setup-actions > .threadlight-mirroring-action-button {
    height: 30px;
    min-height: 30px;
    margin-top: 0;
    margin-bottom: 0;
    border-radius: 6px;
}

/* Shared build checker shell; diagnostics belong to each consumer. */
.threadlight-checker-action-row {
    min-width: 0;
    min-height: 46px;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    padding-top: 7px;
    padding-left: 2px;
    padding-right: 2px;
    border-top-width: 1px;
    background-color: rgba(20, 13, 9, 0.20);
}

.threadlight-checker-validation {
    min-width: 0;
    margin-bottom: 4px;
}

.threadlight-checker-validation-strip {
    min-width: 0;
    height: 28px;
    min-height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-radius: 7px;
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-left-color, border-top-color, border-right-color, border-bottom-color;
    transition-duration: 0.08s;
    transition-timing-function: ease-out;
}

.threadlight-checker-validation-dot {
    width: 8px;
    min-width: 8px;
    height: 8px;
    min-height: 8px;
    margin-right: 8px;
    border-radius: 4px;
}

.threadlight-checker-validation-arrow {
    width: 16px;
    min-width: 16px;
    margin-left: 7px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.threadlight-checker-validation-title {
    -unity-font-style: bold;
    font-size: 11px;
}

.threadlight-checker-validation-summary {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    margin-left: 10px;
    font-size: 10px;
    -unity-text-align: middle-right;
}

.threadlight-checker-validation-messages {
    min-width: 0;
    height: 190px;
    max-height: 190px;
    padding: 4px 2px 4px 2px;
}
.threadlight-checker-dock { flex-direction: column; align-items: stretch; margin: 0; }
.threadlight-footer--stacked .threadlight-checker-action-row { flex-direction: column; align-items: stretch; }
.threadlight-footer--stacked .threadlight-checker-validation-messages { height: 112px; max-height: 112px; }
.threadlight-footer--stacked .threadlight-checker-validation-strip--readiness {
    height: auto;
    flex-direction: column;
    align-items: stretch;
    padding-top: 4px;
    padding-bottom: 4px;
}
.threadlight-footer--stacked .threadlight-checker-validation-strip--readiness > .threadlight-checker-validation-title {
    min-height: 18px;
    padding-left: 16px;
    padding-right: 24px;
    -unity-text-align: middle-left;
}
.threadlight-footer--stacked .threadlight-checker-validation-strip--readiness > .threadlight-checker-validation-dot {
    position: absolute;
    left: 8px;
    top: 9px;
}
.threadlight-footer--stacked .threadlight-checker-validation-strip--readiness > .threadlight-checker-validation-summary {
    margin-left: 16px;
    margin-top: 4px;
    white-space: normal;
    -unity-text-align: middle-left;
}
.threadlight-footer--stacked .threadlight-checker-validation-strip--readiness > .threadlight-checker-validation-arrow {
    position: absolute;
    right: 8px;
    top: 2px;
}
.threadlight-checker-validation-messages > .unity-scroll-view__content-viewport,
.threadlight-checker-validation-messages > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { min-width: 0; }
.threadlight-checker-dock > .threadlight-checker-action-row { flex-shrink: 0; }
.threadlight-checker-action-row > .threadlight-footer-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
